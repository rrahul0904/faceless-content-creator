FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive
ARG MUSETALK_COMMIT=0a89dec45a0192b824e3cf4daf96c239440c5ed8
ARG DOWNLOAD_MODELS=1

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MUSETALK_DIR=/opt/musetalk \
    SHARED_DIR=/shared \
    FFMPEG_PATH=/usr/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.10 python3-pip python3.10-dev git git-lfs ffmpeg curl ca-certificates \
      libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 libsndfile1 build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.10 /usr/local/bin/python

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install torch==2.0.1 torchvision==0.15.2 torchaudio==2.0.2 --index-url https://download.pytorch.org/whl/cu118

RUN git clone https://github.com/TMElyralab/MuseTalk.git /opt/musetalk \
    && cd /opt/musetalk \
    && git checkout ${MUSETALK_COMMIT} \
    && python -m pip install -r requirements.txt \
    && python -m pip install --no-cache-dir -U openmim \
    && mim install mmengine \
    && mim install "mmcv==2.0.1" \
    && mim install "mmdet==3.1.0" \
    && mim install "mmpose==1.1.0"

COPY services/avatar-worker/requirements.txt /tmp/avatar-requirements.txt
RUN python -m pip install -r /tmp/avatar-requirements.txt

RUN if [ "$DOWNLOAD_MODELS" = "1" ]; then cd /opt/musetalk && sh ./download_weights.sh; fi

WORKDIR /service
COPY services/avatar-worker/app.py /service/app.py
RUN mkdir -p /shared/renders /shared/avatar-work

EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8081/healthz || exit 1

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8081", "--workers", "1"]
