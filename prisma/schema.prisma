generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/faceless.db"
}

enum ContentStatus {
  IDEA
  SCRIPTED
  RENDERING
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
}

enum RenderStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum BrandAssetType {
  IMAGE
  COLOR
  FONT
  VIDEO
  AUDIO
}

model Workspace {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  channels    Channel[]
  templates   Template[]
  brandAssets BrandAsset[]
  social      SocialAccount[]
}

model Channel {
  id          String        @id @default(cuid())
  workspaceId String?
  workspace   Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  niche       String
  handle      String?
  voice       String?       @default("en-us")
  templateId  String?       @default("editorial")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  contents    ContentItem[]

  @@index([workspaceId])
}

model Template {
  id           String            @id @default(cuid())
  workspaceId  String?
  workspace    Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  description  String            @default("")
  tags         Json
  schemaVersion Int              @default(1)
  canvasWidth  Int
  canvasHeight Int
  document     Json
  thumbnailUrl String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  versions     TemplateVersion[]
  renderJobs   RenderJob[]

  @@index([workspaceId, updatedAt])
}

model TemplateVersion {
  id        String   @id @default(cuid())
  templateId String
  template  Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version   Int
  document  Json
  createdAt DateTime @default(now())

  @@unique([templateId, version])
  @@index([templateId, createdAt])
}

model BrandAsset {
  id          String         @id @default(cuid())
  workspaceId String?
  workspace   Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type        BrandAssetType
  name        String
  url         String?
  localPath   String?
  mimeType    String?
  value       String?
  tags        Json
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([workspaceId, type])
}

model ContentItem {
  id           String        @id @default(cuid())
  channelId    String
  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  topic        String
  sourceUrl    String?
  hook         String?
  script       String?
  caption      String?
  statNumber   String?
  statLabel    String?
  status       ContentStatus @default(IDEA)
  renderJobId  String?       @unique
  renderJob    RenderJob?    @relation(fields: [renderJobId], references: [id], onDelete: SetNull)
  videoUrl     String?
  scheduledFor DateTime?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  publications Publication[]

  @@index([channelId, status])
}

model RenderJob {
  id         String        @id @default(cuid())
  templateId String?
  template   Template?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status     RenderStatus  @default(QUEUED)
  input      Json
  outputFile String?
  videoUrl   String?
  error      String?
  createdAt  DateTime      @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  updatedAt  DateTime      @updatedAt
  content    ContentItem?

  @@index([status, createdAt])
  @@index([templateId, createdAt])
}

model SocialAccount {
  id                    String     @id @default(cuid())
  workspaceId           String?
  workspace             Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform              String
  label                 String
  username              String?
  status                String     @default("disconnected")
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  metadata              Json?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([platform, status])
  @@index([workspaceId])
}

model Publication {
  id          String      @id @default(cuid())
  contentId   String
  content     ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  platform    String
  accountId   String
  externalId  String?
  status      String
  views       Int?
  likes       Int?
  comments    Int?
  shares      Int?
  saves       Int?
  watchTimeMs Int?
  raw         Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([contentId, platform])
}

model Setting {
  key       String   @id
  value     String
  encrypted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
