generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/faceless.db"
}

enum ContentStatus {
  IDEA
  SCRIPTED
  RENDERING
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
}

enum RenderStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum BrandAssetType {
  IMAGE
  COLOR
  FONT
  VIDEO
  AUDIO
}

enum WorkspacePlan {
  FREE
  CREATOR
  PRO
  BUSINESS
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

enum MembershipRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum UsageKind {
  RENDER_JOB
  AI_VIDEO_JOB
  SOCIAL_PUBLISH
  LLM_REQUEST
  STORAGE_MB
}

enum CreditLedgerType {
  GRANT
  DEBIT
  CREDIT
  ADJUSTMENT
}

model Workspace {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  plan                WorkspacePlan        @default(FREE)
  status              WorkspaceStatus      @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  channels            Channel[]
  templates           Template[]
  brandAssets         BrandAsset[]
  social              SocialAccount[]
  renderJobs          RenderJob[]
  memberships         Membership[]
  apiKeys             ApiKey[]
  usageEvents         UsageEvent[]
  creditLedger        CreditLedger[]
  billingSubscription BillingSubscription?
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  imageUrl    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  sessions    Session[]
}

model Membership {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        MembershipRole @default(EDITOR)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, expiresAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  keyPrefix   String
  keyHash     String    @unique
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, revokedAt])
}

model BillingSubscription {
  id                  String    @id @default(cuid())
  workspaceId         String    @unique
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider            String    @default("manual")
  customerId          String?
  subscriptionId      String?
  priceId             String?
  status              String    @default("inactive")
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([provider, status])
}

model UsageEvent {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind          UsageKind
  quantity      Float     @default(1)
  unit          String    @default("unit")
  referenceType String?
  referenceId   String?
  metadata      Json?
  createdAt     DateTime  @default(now())

  @@index([workspaceId, kind, createdAt])
  @@index([referenceType, referenceId])
}

model CreditLedger {
  id           String           @id @default(cuid())
  workspaceId  String
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type         CreditLedgerType
  amount       Int
  balanceAfter Int
  reason       String
  referenceId  String?
  createdAt    DateTime         @default(now())

  @@index([workspaceId, createdAt])
}

model Channel {
  id          String        @id @default(cuid())
  workspaceId String?
  workspace   Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  niche       String
  handle      String?
  voice       String?       @default("en-us")
  templateId  String?       @default("editorial")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  contents    ContentItem[]

  @@index([workspaceId])
}

model Template {
  id            String            @id @default(cuid())
  workspaceId   String?
  workspace     Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  description   String            @default("")
  tags          Json
  schemaVersion Int               @default(1)
  canvasWidth   Int
  canvasHeight  Int
  document      Json
  thumbnailUrl  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  versions      TemplateVersion[]
  renderJobs    RenderJob[]

  @@index([workspaceId, updatedAt])
}

model TemplateVersion {
  id         String   @id @default(cuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version    Int
  document   Json
  createdAt  DateTime @default(now())

  @@unique([templateId, version])
  @@index([templateId, createdAt])
}

model BrandAsset {
  id          String         @id @default(cuid())
  workspaceId String?
  workspace   Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type        BrandAssetType
  name        String
  url         String?
  localPath   String?
  mimeType    String?
  value       String?
  tags        Json
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([workspaceId, type])
}

model ContentItem {
  id           String        @id @default(cuid())
  channelId    String
  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  topic        String
  sourceUrl    String?
  hook         String?
  script       String?
  caption      String?
  statNumber   String?
  statLabel    String?
  status       ContentStatus @default(IDEA)
  renderJobId  String?       @unique
  renderJob    RenderJob?    @relation(fields: [renderJobId], references: [id], onDelete: SetNull)
  videoUrl     String?
  scheduledFor DateTime?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  publications Publication[]

  @@index([channelId, status])
  @@index([status, scheduledFor])
}

model RenderJob {
  id              String        @id @default(cuid())
  workspaceId     String?
  workspace       Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  templateId      String?
  template        Template?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status          RenderStatus  @default(QUEUED)
  cancelRequested Boolean       @default(false)
  input           Json
  outputFile      String?
  videoUrl        String?
  error           String?
  createdAt       DateTime      @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  updatedAt       DateTime      @updatedAt
  content         ContentItem?

  @@index([workspaceId, status, createdAt])
  @@index([status, createdAt])
  @@index([templateId, createdAt])
}

model SocialAccount {
  id                    String     @id @default(cuid())
  workspaceId           String?
  workspace             Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform              String
  label                 String
  username              String?
  status                String     @default("disconnected")
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  metadata              Json?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([platform, status])
  @@index([workspaceId])
}

model Publication {
  id           String      @id @default(cuid())
  contentId    String
  content      ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  platform     String
  accountId    String
  externalId   String?
  status       String      @default("QUEUED")
  scheduledFor DateTime?
  startedAt    DateTime?
  publishedAt  DateTime?
  attempts     Int         @default(0)
  lastError    String?
  views        Int?
  likes        Int?
  comments     Int?
  shares       Int?
  saves        Int?
  watchTimeMs  Int?
  raw          Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([contentId, platform])
  @@index([status, scheduledFor])
  @@index([accountId, createdAt])
}

model Setting {
  key       String   @id
  value     String
  encrypted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
