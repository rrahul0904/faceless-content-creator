generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentStatus {
  IDEA
  SCRIPTED
  RENDERING
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
}

model Channel {
  id          String        @id @default(cuid())
  name        String
  niche       String
  handle      String?
  voice       String?
  templateId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  contents    ContentItem[]
}

model ContentItem {
  id           String        @id @default(cuid())
  channelId    String
  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  topic        String
  sourceUrl    String?
  hook         String?
  script       String?
  caption      String?
  statNumber   String?
  statLabel    String?
  status       ContentStatus @default(IDEA)
  renderJobId  Int?
  videoUrl     String?
  scheduledFor DateTime?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  publications Publication[]

  @@index([channelId, status])
}

model Publication {
  id          String      @id @default(cuid())
  contentId   String
  content     ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  platform    String
  accountId   Int
  externalId  String?
  status      String
  views       Int?
  likes       Int?
  comments    Int?
  shares      Int?
  saves       Int?
  watchTimeMs Int?
  raw         Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([contentId, platform])
}
