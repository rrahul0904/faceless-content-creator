generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/faceless.db"
}

enum ContentStatus {
  IDEA
  SCRIPTED
  RENDERING
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
}

enum RenderStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model Channel {
  id          String        @id @default(cuid())
  name        String
  niche       String
  handle      String?
  voice       String?       @default("en-us")
  templateId  String?       @default("editorial")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  contents    ContentItem[]
}

model ContentItem {
  id           String        @id @default(cuid())
  channelId    String
  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  topic        String
  sourceUrl    String?
  hook         String?
  script       String?
  caption      String?
  statNumber   String?
  statLabel    String?
  status       ContentStatus @default(IDEA)
  renderJobId  String?       @unique
  renderJob    RenderJob?    @relation(fields: [renderJobId], references: [id], onDelete: SetNull)
  videoUrl     String?
  scheduledFor DateTime?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  publications Publication[]

  @@index([channelId, status])
}

model RenderJob {
  id         String        @id @default(cuid())
  status     RenderStatus  @default(QUEUED)
  input      Json
  outputFile String?
  videoUrl   String?
  error      String?
  createdAt  DateTime      @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  updatedAt  DateTime      @updatedAt
  content    ContentItem?

  @@index([status, createdAt])
}

model SocialAccount {
  id                    String   @id @default(cuid())
  platform              String
  label                 String
  username              String?
  status                String   @default("disconnected")
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([platform, status])
}

model Publication {
  id          String      @id @default(cuid())
  contentId   String
  content     ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  platform    String
  accountId   String
  externalId  String?
  status      String
  views       Int?
  likes       Int?
  comments    Int?
  shares      Int?
  saves       Int?
  watchTimeMs Int?
  raw         Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([contentId, platform])
}

model Setting {
  key       String   @id
  value     String
  encrypted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
