# Generate a strong random value before deployment.
CREATOR_DATA_TOKEN=replace-me

# Docker Compose binds the service to loopback by default.
# Put TLS/reverse-proxy in front of it for remote Creator Console access.
CREATOR_DATA_BIND=127.0.0.1
CREATOR_DATA_PORT=8787

# Stable named Docker volume. Do not delete this volume during service upgrades.
CREATOR_DATA_VOLUME=creator-data
