{
  "name": "faceless-content-creator",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "api-key:create": "node scripts/create-api-key.mjs",
    "render:smoke": "node scripts/smoke-render.mjs",
    "http:smoke": "node scripts/smoke-http.mjs",
    "auth:smoke": "node scripts/smoke-auth.mjs",
    "limits:smoke": "node scripts/smoke-limits.mjs",
    "workflow:smoke": "rm -rf .tmp/workflow-smoke && npx tsc --target ES2022 --module commonjs --moduleResolution node --esModuleInterop --skipLibCheck --outDir .tmp/workflow-smoke scripts/workflow-compiler-smoke.ts lib/workflow-compiler/*.ts && node .tmp/workflow-smoke/scripts/workflow-compiler-smoke.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "lucide-react": "0.544.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prisma": "6.19.3",
    "typescript": "5.9.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
