# No environment variables are required for the deterministic local render experience.
# Local mode uses SQLite at data/faceless.db, FFmpeg, eSpeak NG and request-relative media URLs.

# Optional: OpenAI-compatible script generation. The built-in deterministic writer is used when omitted.
# LLM_BASE_URL=""
# LLM_API_KEY=""
# LLM_MODEL=""

# Optional: GPU AI-presenter service. docker-compose.gpu.yml provides the default service hostname.
# AVATAR_SERVICE_URL="http://avatar-worker:8081"

# Optional but REQUIRED before persisting YouTube / Instagram / TikTok access or refresh tokens.
# Use a long random secret in hosted environments; do not commit its real value.
# SOCIAL_TOKEN_KEY=""
# APP_SECRET=""

# Platform OAuth client credentials are deployment-specific and belong in the hosted SaaS/OAuth layer.
# They are intentionally not required for local video creation or export.
