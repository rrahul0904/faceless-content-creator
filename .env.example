# No environment variables are required for the default self-hosted experience.
#
# The application uses:
# - SQLite at data/faceless.db
# - FFmpeg for local video rendering
# - eSpeak NG for local text-to-speech
# - request-relative URLs for media playback
#
# Optional: point script generation at an OpenAI-compatible model endpoint.
# If these are omitted, the built-in deterministic script engine is used.
# LLM_BASE_URL=""
# LLM_API_KEY=""
# LLM_MODEL=""
