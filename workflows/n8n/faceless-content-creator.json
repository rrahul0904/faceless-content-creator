{
  "name": "Faceless Content Creator — Local zero-config render",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "fcc-local-001",
      "name": "Every day at 9am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-720, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "app_url",
              "value": "http://host.docker.internal:3000",
              "type": "string"
            },
            {
              "id": "2",
              "name": "niche",
              "value": "Artificial intelligence",
              "type": "string"
            },
            {
              "id": "3",
              "name": "idea",
              "value": "Why AI agents need memory",
              "type": "string"
            },
            {
              "id": "4",
              "name": "voice",
              "value": "en-us",
              "type": "string"
            },
            {
              "id": "5",
              "name": "speechRate",
              "value": 165,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "fcc-local-002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-500, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.app_url }}/api/script",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"niche\": \"{{ $json.niche }}\",\n  \"idea\": \"{{ $json.idea }}\"\n}",
        "options": {}
      },
      "id": "fcc-local-003",
      "name": "Generate script",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.app_url }}/api/render",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"topic\": \"{{ $json.result.topic }}\",\n  \"hook\": \"{{ $json.result.hook }}\",\n  \"script\": \"{{ $json.result.script }}\",\n  \"caption\": \"{{ $json.result.caption }}\",\n  \"voice\": \"{{ $('Config').item.json.voice }}\",\n  \"speechRate\": {{ $('Config').item.json.speechRate }}\n}",
        "options": {}
      },
      "id": "fcc-local-004",
      "name": "Queue local render",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-20, 300]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "fcc-local-005",
      "name": "Wait for renderer",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [220, 300],
      "webhookId": "faceless-local-render-wait"
    },
    {
      "parameters": {
        "url": "={{ $('Config').item.json.app_url }}/api/render/{{ $('Queue local render').item.json.job.id }}",
        "options": {}
      },
      "id": "fcc-local-006",
      "name": "Check render",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "render-finished",
              "leftValue": "={{ $json.job.finished }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "fcc-local-007",
      "name": "Finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "url": "={{ $('Config').item.json.app_url }}{{ $json.job.result.data.content }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "fcc-local-008",
      "name": "Fetch rendered MP4",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 220]
    },
    {
      "parameters": {
        "content": "## Review gate\nThe workflow has produced the final MP4 using the local Faceless Content Creator service. Review the binary output before adding any native YouTube, Instagram or TikTok publishing node.",
        "height": 180,
        "width": 360
      },
      "id": "fcc-local-009",
      "name": "Review before native publish",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [920, 20]
    }
  ],
  "connections": {
    "Every day at 9am": {
      "main": [[{"node": "Config", "type": "main", "index": 0}]]
    },
    "Config": {
      "main": [[{"node": "Generate script", "type": "main", "index": 0}]]
    },
    "Generate script": {
      "main": [[{"node": "Queue local render", "type": "main", "index": 0}]]
    },
    "Queue local render": {
      "main": [[{"node": "Wait for renderer", "type": "main", "index": 0}]]
    },
    "Wait for renderer": {
      "main": [[{"node": "Check render", "type": "main", "index": 0}]]
    },
    "Check render": {
      "main": [[{"node": "Finished?", "type": "main", "index": 0}]]
    },
    "Finished?": {
      "main": [
        [{"node": "Fetch rendered MP4", "type": "main", "index": 0}],
        [{"node": "Wait for renderer", "type": "main", "index": 0}]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {}
}
